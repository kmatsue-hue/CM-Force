rules_version = '2';

// 注意: 現状はクライアントサイドのパスワードログインがアクセスゲート。
// Firebase Authentication 未統合のため、Firestore 自体のセキュリティはオープンです。
// 公開情報・社内デモ用途を想定しています。本格運用時は Auth 連携 + 厳格ルールに置き換えてください。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
